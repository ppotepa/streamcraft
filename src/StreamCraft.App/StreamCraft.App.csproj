<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>StreamCraft.App</RootNamespace>
    <AssemblyName>StreamCraft.App</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StreamCraft.Core\StreamCraft.Core.csproj" />
    <ProjectReference Include="..\StreamCraft.Engine\StreamCraft.Engine.csproj" />
    <ProjectReference Include="..\StreamCraft.Hosting\StreamCraft.Hosting.csproj" />
    <ProjectReference Include="..\StreamCraft.UI\StreamCraft.UI.csproj" />
    <ProjectReference Include="..\..\Bits\Core\Debug\Debug\Debug.csproj">
      <Private>false</Private>
      <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    </ProjectReference>
    <ProjectReference Include="..\..\Bits\Core\EventPlayground\EventPlayground\EventPlayground.csproj">
      <Private>false</Private>
      <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    </ProjectReference>
    <ProjectReference Include="..\..\Bits\Core\Plugins\Plugins.csproj">
      <Private>false</Private>
      <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    </ProjectReference>
    <ProjectReference Include="..\..\Bits\Core\Logging\Exceptions.csproj">
      <Private>false</Private>
      <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    </ProjectReference>
    <ProjectReference Include="..\..\Bits\Core\Designer\Designer.csproj">
      <Private>false</Private>
      <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    </ProjectReference>
    <ProjectReference Include="..\..\Bits\Data\PublicApiSources\PublicApiSources.csproj">
      <Private>false</Private>
      <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    </ProjectReference>
    <ProjectReference Include="..\..\Bits\Data\SystemDataSources\SystemDataSources.csproj">
      <Private>false</Private>
      <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    </ProjectReference>
    <ProjectReference Include="..\..\Bits\Core\Vault\Vault.csproj">
      <Private>false</Private>
      <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    </ProjectReference>
    <ProjectReference Include="..\..\Bits\Media\PexelsMedia\PexelsMedia.csproj">
      <Private>false</Private>
      <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    </ProjectReference>
    <ProjectReference Include="..\..\Bits\Media\TextStyles\TextStyles.csproj">
      <Private>false</Private>
      <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    </ProjectReference>
    <ProjectReference Include="..\..\Bits\Ai\Ai.csproj">
      <Private>false</Private>
      <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    </ProjectReference>
    <ProjectReference Include="..\..\Bits\Games\Sc2\Sc2.csproj">
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="..\..\themes.html">
      <Link>themes.html</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="..\StreamCraft.UI\static\index.html">
      <Link>static\ui\index.html</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="..\StreamCraft.UI\static\app.js">
      <Link>static\ui\app.js</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="..\StreamCraft.UI\static\styles.css">
      <Link>static\ui\styles.css</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="..\StreamCraft.Hosting\static\**\*">
      <Link>static\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <Target Name="CleanBitsFolder" BeforeTargets="CopyBitDlls">
    <!-- Remove any old DLL files from top-level bits folder -->
    <ItemGroup>
      <OldBitDlls Include="$(OutputPath)bits\*.dll" />
    </ItemGroup>
    <Delete Files="@(OldBitDlls)" ContinueOnError="true" />
  </Target>

  <Target Name="CopyBitDlls" AfterTargets="Build">
    <ItemGroup>
      <BitDebugFiles Include="..\..\Bits\Core\Debug\Debug\bin\$(Configuration)\net8.0\**\*.*" />
      <BitEventPlaygroundFiles Include="..\..\Bits\Core\EventPlayground\EventPlayground\bin\$(Configuration)\net8.0\**\*.*" />
      <BitPluginsFiles Include="..\..\Bits\Core\Plugins\bin\$(Configuration)\net8.0\**\*.*" />
      <BitExceptionsFiles Include="..\..\Bits\Core\Logging\bin\$(Configuration)\net8.0\**\*.*" />
      <BitDesignerFiles Include="..\..\Bits\Core\Designer\bin\$(Configuration)\net8.0\**\*.*" />
      <BitPublicApiSourcesFiles Include="..\..\Bits\Data\PublicApiSources\bin\$(Configuration)\net8.0\**\*.*" />
      <BitSystemDataSourcesFiles Include="..\..\Bits\Data\SystemDataSources\bin\$(Configuration)\net8.0\**\*.*" />
      <BitVaultFiles Include="..\..\Bits\Core\Vault\bin\$(Configuration)\net8.0\**\*.*" />
      <BitPexelsMediaFiles Include="..\..\Bits\Media\PexelsMedia\bin\$(Configuration)\net8.0\**\*.*" />
      <BitTextStylesFiles Include="..\..\Bits\Media\TextStyles\bin\$(Configuration)\net8.0\**\*.*" />
      <BitAiFiles Include="..\..\Bits\Ai\bin\$(Configuration)\net8.0\**\*.*" />
      <BitSc2Files Include="..\..\Bits\Games\Sc2\bin\$(Configuration)\net8.0\**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(OutputPath)bits\Debug" />
    <MakeDir Directories="$(OutputPath)bits\EventPlayground" />
    <MakeDir Directories="$(OutputPath)bits\Plugins" />
    <MakeDir Directories="$(OutputPath)bits\Exceptions" />
    <MakeDir Directories="$(OutputPath)bits\Designer" />
    <MakeDir Directories="$(OutputPath)bits\PublicApiSources" />
    <MakeDir Directories="$(OutputPath)bits\SystemDataSources" />
    <MakeDir Directories="$(OutputPath)bits\Vault" />
    <MakeDir Directories="$(OutputPath)bits\PexelsMedia" />
    <MakeDir Directories="$(OutputPath)bits\TextStyles" />
    <MakeDir Directories="$(OutputPath)bits\Ai" />
    <MakeDir Directories="$(OutputPath)bits\Sc2" />
    <Copy SourceFiles="@(BitDebugFiles)" DestinationFolder="$(OutputPath)bits\Debug\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BitEventPlaygroundFiles)" DestinationFolder="$(OutputPath)bits\EventPlayground\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BitPluginsFiles)" DestinationFolder="$(OutputPath)bits\Plugins\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BitExceptionsFiles)" DestinationFolder="$(OutputPath)bits\Exceptions\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BitDesignerFiles)" DestinationFolder="$(OutputPath)bits\Designer\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BitPublicApiSourcesFiles)" DestinationFolder="$(OutputPath)bits\PublicApiSources\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BitSystemDataSourcesFiles)" DestinationFolder="$(OutputPath)bits\SystemDataSources\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BitVaultFiles)" DestinationFolder="$(OutputPath)bits\Vault\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BitPexelsMediaFiles)" DestinationFolder="$(OutputPath)bits\PexelsMedia\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BitTextStylesFiles)" DestinationFolder="$(OutputPath)bits\TextStyles\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BitAiFiles)" DestinationFolder="$(OutputPath)bits\Ai\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BitSc2Files)" DestinationFolder="$(OutputPath)bits\Sc2\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyBitsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <PublishedBits Include="$(OutputPath)bits\**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)bits" />
    <Copy SourceFiles="@(PublishedBits)" DestinationFolder="$(PublishDir)bits\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>

