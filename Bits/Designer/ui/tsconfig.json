{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@streamcraft/forms": [
        "../../../libs/forms"
      ],
      "@streamcraft/forms/*": [
        "../../../libs/forms/*"
      ]
    }
  },
  "include": [
    "src",
    "../../../libs/forms"
  ]
}