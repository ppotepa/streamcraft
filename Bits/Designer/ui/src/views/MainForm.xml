<?xml version="1.0" encoding="utf-8"?>
<Form>
  <Template id="RightPanel">
    <Dock class="dock-right">
      <Panel title="Properties">
        <Element tag="div" class="form-grid">
          <Text>X</Text><Element tag="input" type="number" defaultValue="120" />
          <Text>Y</Text><Element tag="input" type="number" defaultValue="140" />
          <Text>Width</Text><Element tag="input" type="number" defaultValue="420" />
          <Text>Height</Text><Element tag="input" type="number" defaultValue="240" />
        </Element>
      </Panel>
      <Panel title="Layers">
        <Element tag="ul" class="list">
          <Element tag="li"><Text>Header</Text></Element>
          <Element tag="li"><Text>Text: Stream Starting</Text></Element>
          <Element tag="li"><Text>Image: Host Avatar</Text></Element>
        </Element>
      </Panel>
    </Dock>
  </Template>

  <Window title="StreamCraft — Designer Layout">
    <MenuBar>
      <MenuItem label="File"><Text>New</Text><Text>Open</Text><Text>Save</Text><Text>Save As</Text><Text>Export</Text><Text>Close</Text></MenuItem>
      <MenuItem label="Edit"><Text>Undo</Text><Text>Redo</Text><Text>Cut</Text><Text>Copy</Text><Text>Paste</Text></MenuItem>
      <MenuItem label="View"><Text>Zoom</Text><Text>Rulers</Text><Text>Guides</Text><Text>Grid</Text><Text>Snap</Text></MenuItem>
      <MenuItem label="Insert"><Text>Text</Text><Text>Image</Text><Text>Video</Text></MenuItem>
      <MenuItem label="Window"><Text>Reset Layout</Text><Text>Panels</Text></MenuItem>
      <MenuItem label="Help"><Text>Shortcuts</Text><Text>About</Text></MenuItem>
    </MenuBar>

    <View class="workspace">
      <View class="toolbox-floaty" draggable="true" dragBounds=".workspace" dragHandle=".title-bar">
        <Panel title="Toolbox">
          <Element tag="div" class="toolbox-grid">
            <Element tag="button" class="button icon-button" title="Select">
              <Element tag="span" class="tool-icon" data-icon="select" />
            </Element>
            <Element tag="button" class="button icon-button" title="Rectangle">
              <Element tag="span" class="tool-icon" data-icon="rect" />
            </Element>
            <Element tag="button" class="button icon-button" title="Line">
              <Element tag="span" class="tool-icon" data-icon="line" />
            </Element>
            <Element tag="button" class="button icon-button" title="Text">
              <Element tag="span" class="tool-icon" data-icon="text" />
            </Element>
            <Element tag="button" class="button icon-button" title="Image">
              <Element tag="span" class="tool-icon" data-icon="image" />
            </Element>
            <Element tag="button" class="button icon-button" title="Bind">
              <Element tag="span" class="tool-icon" data-icon="bind" />
            </Element>
          </Element>
        </Panel>
      </View>

      <Canvas>
        <Element tag="div" class="canvas-area">
          <Element tag="div" class="artboard">
            <Element tag="div" class="safe-area" />
            <Element tag="div" class="canvas-label"><Text>1920 × 1080</Text></Element>
          </Element>
        </Element>
      </Canvas>

      <Use template="RightPanel" />
    </View>
  </Window>
</Form>
