<?xml version="1.0" encoding="utf-8"?>
<Form>
  <Template id="RightPanel">
    <Dock class="dock-right">
      <Panel title="Properties">
        <Element tag="div" class="form-grid">
          <Text>X</Text><Element tag="input" type="number" defaultValue="120" />
          <Text>Y</Text><Element tag="input" type="number" defaultValue="140" />
          <Text>Width</Text><Element tag="input" type="number" defaultValue="420" />
          <Text>Height</Text><Element tag="input" type="number" defaultValue="240" />
        </Element>
      </Panel>
      <Panel title="Layers">
        <Element tag="ul" class="list">
          <Element tag="li"><Text>Header</Text></Element>
          <Element tag="li"><Text>Text: Stream Starting</Text></Element>
          <Element tag="li"><Text>Image: Host Avatar</Text></Element>
        </Element>
      </Panel>
    </Dock>
  </Template>

  <Window title="StreamCraft — Designer Layout">
    <MenuBar>
      <MenuItem label="File"><Text>New</Text><Text>Open</Text><Text>Save</Text><Text>Save As</Text><Text>Export</Text><Text>Close</Text></MenuItem>
      <MenuItem label="Edit"><Text>Undo</Text><Text>Redo</Text><Text>Cut</Text><Text>Copy</Text><Text>Paste</Text></MenuItem>
      <MenuItem label="View"><Text>Zoom</Text><Text>Rulers</Text><Text>Guides</Text><Text>Grid</Text><Text>Snap</Text><Text onclick="window.__showLivePreview?.()">Live Preview</Text><Text onclick="window.__showMediaTest?.()">Media Test</Text></MenuItem>
      <MenuItem label="Insert"><Text>Text</Text><Text>Image</Text><Text>Video</Text></MenuItem>
      <MenuItem label="Window"><Text>Reset Layout</Text><Text>Panels</Text></MenuItem>
      <MenuItem label="Help"><Text>Shortcuts</Text><Text>About</Text></MenuItem>
    </MenuBar>

    <Element tag="div" class="tool-strip">
      <Element tag="div" class="tool-tiles">
        <Element tag="button" class="button"><Text>Move</Text></Element>
        <Element tag="button" class="button"><Text>Select</Text></Element>
        <Element tag="button" class="button"><Text>Crop</Text></Element>
        <Element tag="button" class="button"><Text>Brush</Text></Element>
        <Element tag="button" class="button"><Text>Erase</Text></Element>
        <Element tag="button" class="button"><Text>Type</Text></Element>
        <Element tag="button" class="button"><Text>Shape</Text></Element>
        <Element tag="button" class="button"><Text>Hand</Text></Element>
        <Element tag="button" class="button"><Text>Zoom</Text></Element>
      </Element>
      <Element tag="div" class="tool-options">
        <Element tag="div" class="tool-options-title"><Text>Tool Options</Text></Element>
        <Element tag="div" class="tool-options-row">
          <Element tag="label"><Text>Size</Text></Element>
          <Element tag="input" type="number" defaultValue="24" />
          <Element tag="label"><Text>Opacity</Text></Element>
          <Element tag="input" type="number" defaultValue="100" />
          <Element tag="label"><Text>Snap</Text></Element>
          <Element tag="select">
            <Element tag="option"><Text>On</Text></Element>
            <Element tag="option"><Text>Off</Text></Element>
          </Element>
        </Element>
      </Element>
      <Element tag="div" class="tool-actions">
        <Element tag="button" class="button"><Text>Preview</Text></Element>
        <Element tag="button" class="button"><Text>Export</Text></Element>
      </Element>
    </Element>

    <Element tag="div" class="doc-bar">
      <Element tag="div" class="doc-tabs">
        <Element tag="button" class="button"><Text>Scene 01</Text></Element>
        <Element tag="button" class="button"><Text>Scene 02</Text></Element>
        <Element tag="button" class="button"><Text>Overlay</Text></Element>
      </Element>
      <Element tag="div" class="doc-controls">
        <Element tag="button" class="button"><Text>Fit</Text></Element>
        <Element tag="button" class="button"><Text>100%</Text></Element>
        <Element tag="button" class="button"><Text>Grid</Text></Element>
      </Element>
    </Element>

    <View class="workspace">
      <View class="toolbox-floaty" draggable="true" dragBounds=".workspace" dragHandle=".title-bar">
        <Panel title="Toolbox" minimize="false" maximize="false" close="true">
          <Element tag="div" class="toolbox-grid">
            <Element tag="button" class="button icon-button" title="Select">
              <Element tag="span" class="tool-icon" data-icon="select" />
            </Element>
            <Element tag="button" class="button icon-button" title="Rectangle">
              <Element tag="span" class="tool-icon" data-icon="rect" />
            </Element>
            <Element tag="button" class="button icon-button" title="Line">
              <Element tag="span" class="tool-icon" data-icon="line" />
            </Element>
            <Element tag="button" class="button icon-button" title="Text">
              <Element tag="span" class="tool-icon" data-icon="text" />
            </Element>
            <Element tag="button" class="button icon-button" title="Image">
              <Element tag="span" class="tool-icon" data-icon="image" />
            </Element>
            <Element tag="button" class="button icon-button" title="Ellipse">
              <Element tag="span" class="tool-icon" data-icon="ellipse" />
            </Element>
            <Element tag="button" class="button icon-button" title="Polygon">
              <Element tag="span" class="tool-icon" data-icon="polygon" />
            </Element>
            <Element tag="button" class="button icon-button" title="Hand">
              <Element tag="span" class="tool-icon" data-icon="hand" />
            </Element>
            <Element tag="button" class="button icon-button" title="Zoom">
              <Element tag="span" class="tool-icon" data-icon="zoom" />
            </Element>
            <Element tag="button" class="button icon-button" title="Bind">
              <Element tag="span" class="tool-icon" data-icon="bind" />
            </Element>
          </Element>
        </Panel>
      </View>

      <PanelContainer>
        <Canvas>
          <Element tag="div" class="canvas-area">
            <Element tag="div" class="artboard">
              <Element tag="div" class="safe-area" />
              <Element tag="div" class="canvas-label"><Text>1920 × 1080</Text></Element>
            </Element>
          </Element>
        </Canvas>
        <Grid class="overlay-grid">
          <Element tag="div" class="overlay-hint"><Text>Overlay Layer</Text></Element>
        </Grid>
      </PanelContainer>

      <Use template="RightPanel" />
    </View>

    <Element tag="footer" class="status-bar">
      <Element tag="div" class="status-bar-field"><Text>Canvas: 1920 × 1080</Text></Element>
      <Element tag="div" class="status-bar-field"><Text>Zoom: 100%</Text></Element>
      <Element tag="div" class="status-bar-field"><Text>Snap: On</Text></Element>
    </Element>
  </Window>
</Form>
