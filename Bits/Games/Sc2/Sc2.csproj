<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/StreamCraft.Core/StreamCraft.Core.csproj" />
    <ProjectReference Include="..\Sc2.Messages\Sc2.Messages.csproj" />
    <ProjectReference Include="..\..\..\libs\Sc2PulseClient\Sc2PulseClient.csproj" />
    <ProjectReference Include="..\..\..\libs\Sc2GameDataClient\Sc2GameDataClient.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.App" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="bit.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Include the built UI files in the output -->
  <ItemGroup>
    <Content Include="ui\dist\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="sc2exp\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="sc2hr\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="sql\migrations\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>




