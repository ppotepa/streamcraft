      container={canvasRef.current ?? undefined}
      draggable
      resizable
      snappable={snapEnabled}
      snapGridWidth={GRID_SIZE}
      snapGridHeight={GRID_SIZE}
      elementGuidelines={Array.from(document.querySelectorAll(".overlay-widget"))}
