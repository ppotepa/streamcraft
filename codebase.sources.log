}

.canvas-item-handles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 5;
    display: none;
}

.canvas-item-handle {
    position: absolute;
    width: 8px;
    height: 8px;
    background: #ffffff;
    border: 1px solid #2b7cff;
    box-sizing: border-box;
    pointer-events: auto;
}

.canvas-item-selected .canvas-item-handles {
    display: block;
}

.canvas-item-handle-nw {
    left: -5px;
    top: -5px;
    cursor: nwse-resize;
}

.canvas-item-handle-ne {
    right: -5px;
    top: -5px;
    cursor: nesw-resize;
}

.canvas-item-handle-sw {
    left: -5px;
    bottom: -5px;
    cursor: nesw-resize;
}

.canvas-item-handle-se {
    right: -5px;
    bottom: -5px;
    cursor: nwse-resize;
}

/* Canvas properties panel */
.canvas-properties {
    background: transparent;
    color: inherit;
    border: none;
    border-radius: 0;
    padding: 6px 4px;
    font-size: 12px;
}

.canvas-properties-title {
    font-weight: 600;
    margin-bottom: 8px;
}

.canvas-properties-empty {
    opacity: 0.75;
}

.canvas-properties-body {
    display: grid;
    gap: 8px;
}

.canvas-properties-section {
    display: grid;
    gap: 8px;
}

.canvas-properties-row {
    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 6px;
    align-items: center;
}

.canvas-properties-row label {
    font-size: 11px;
    opacity: 0.85;
}

.canvas-properties-row input {
    width: 100%;
    box-sizing: border-box;
    padding: 4px 6px;
    font-size: 12px;
}

.canvas-properties-row .checkbox-label {
    justify-self: start;
}

.canvas-properties-row .checkbox {
    width: auto;
    padding: 0;
}

.canvas-properties-row input[type="color"] {
    padding: 0;
    height: 24px;
}

.canvas-properties-button {
    grid-column: 2 / -1;
    justify-self: start;
    padding: 4px 8px;
    font-size: 11px;
    cursor: pointer;
}

.canvas-properties-readonly {
    padding: 4px 6px;
    background: rgba(0, 0, 0, 0.05);
    border-radius: 4px;
}

.canvas-properties-event {
    font-size: 11px;
    padding: 4px 6px;
    background: rgba(0, 0, 0, 0.05);
    border-radius: 4px;
}

