            dock: "top",
            layout: { gap: "6px" },
            style: "padding: 8px;"
        });
        expect(style?.position).toBe("absolute");
        expect(style?.top).toBe(0);
        expect(style?.gap).toBe("6px");
        expect(style?.padding).toBe("8px");
    });
});


