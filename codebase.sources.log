/* === SC2-style MMR Progress Bar === */

.sc2-bar {
    --p: 0;
    --w: 800px;
    --h: 75px;

    /* Frame palette */
    --frame0: #071018;
    --frame1: #0a1a27;
    --frame2: #14354b;

