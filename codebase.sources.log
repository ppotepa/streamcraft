  justify-content: space-between;
  font-size: 0.85rem;
  color: var(--muted);
}

.metadata-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  max-height: 240px;
  overflow: auto;
}

.metadata-row {
  display: grid;
  grid-template-columns: 1.4fr 0.6fr 1fr;
  gap: 8px;
  font-size: 0.75rem;
  align-items: center;
}

.field-path {
  color: var(--text);
}

.field-type {
  color: var(--accent-3);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 0.65rem;
}

.field-type.is-container {
  color: var(--accent-2);
}

.field-example {
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.response-body {
  flex: 1;
  background: rgba(8, 12, 16, 0.7);
  border-radius: 12px;
  padding: 12px;
  overflow: auto;
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.response-body pre {
  margin: 0;
  font-size: 0.75rem;
  color: var(--text);
}

.muted {
  color: var(--muted);
  font-size: 0.85rem;
}

.preview-modal {
  position: fixed;
  inset: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(6, 10, 14, 0.7);
  backdrop-filter: blur(6px);
}

.preview-window {
  position: relative;
  width: min(1100px, 90vw);
  height: min(620px, 80vh);
  border-radius: 18px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  overflow: hidden;
  background: #0b1116;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 18px;
  gap: 12px;
  box-shadow: var(--shadow);
}

.preview-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.55;
}

.preview-overlay {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
}

.preview-overlay .overlay-widget {
    pointer-events: none;
}

.designer-loading-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 2147483647;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(160, 160, 160, 0.6);
    backdrop-filter: grayscale(1) contrast(0.85);
    pointer-events: all;
}

.designer-loading-window {
    width: min(420px, 86vw);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.25);
    z-index: 1;
}

.designer-loading-body {
    display: grid;
    gap: 10px;
    padding: 12px;
}

.designer-loading-step {
    font-weight: 600;
    color: #1b1b1b;
}

.designer-loading-log {
    display: grid;
    gap: 2px;
    font-size: 12px;
    color: #3a3a3a;
    max-height: 120px;
    overflow: hidden;
}

.designer-loading-log-entry::before {
    content: "• ";
}

@media (max-width: 1000px) {
  .designer-app {
    padding: 16px;
  }

  .app-header {
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-grid {
    grid-template-columns: 1fr;
  }

  .widget-binding {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

.moveable-control-box {
  --moveable-color: var(--accent);
}

.moveable-control-box .moveable-line {
  background: var(--accent);
}

.moveable-control-box .moveable-control {
  width: 10px !important;
  height: 10px !important;
  border-radius: 50%;
  background: var(--accent);
  border: 2px solid #0b1116;
  box-shadow: 0 0 0 1px rgba(47, 230, 168, 0.4);
}

.moveable-control-box .moveable-rotation {
  background: var(--accent-3);
}

/* Widget editor modal */
.editor-modal {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.editor-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(6, 10, 14, 0.75);
  backdrop-filter: blur(8px);
}

.editor-panel {
  position: relative;
  width: min(960px, 92vw);
  max-height: 82vh;
  background: var(--panel);
  border: 1px solid var(--stroke);
  border-radius: 18px;
  padding: 20px;
  box-shadow: var(--shadow);
  overflow: auto;
}

.editor-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 14px;
}

.editor-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.editor-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 16px;
}

.editor-section {
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 14px;
  padding: 14px;
  background: rgba(12, 18, 26, 0.6);
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 0.9rem;
}

.field input,
.field select,
.field textarea {
  width: 100%;
  background: rgba(8, 12, 16, 0.9);
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 10px;
  color: var(--text);
  padding: 10px;
  font-size: 0.9rem;
}

.layout-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.editor-note {
  color: var(--muted);
  font-size: 0.85rem;
}



