                        type: "number",
                        min: 0,
                        max: 40,
                        value: selectedItem.textShadowBlur ?? 0,
                        onChange: (event: React.ChangeEvent<HTMLInputElement>) =>
                            updateItem({ textShadowBlur: Math.max(0, Number(event.target.value) || 0) }),
                    })
                ),
                element(
                    "div",
