    /**
     * Whether panel can be maximized
     */
    public maximizable: boolean = false;

    /**
     * Whether panel can be dragged
     */
    public draggable: boolean = false;

    /**
     * Panel dock position
     */
    public dock?: "top" | "bottom" | "left" | "right" | "fill";

    /**
