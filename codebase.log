    public bool TryGet(string sourceId, string endpointPath, string method, out ApiResponseMetadata metadata)
    {
        if (_map.TryGetValue(MetadataKey.From(sourceId, endpointPath, method), out var factory))
        {
            metadata = factory();
            return true;
        }

        metadata = Missing;
        return false;
    }
