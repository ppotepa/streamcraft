if ($Watch) {
    $designerUiPath = Join-Path $root "Bits\Designer\ui"
    if (-not (Test-Path $designerUiPath)) {
        throw "Designer UI path not found: $designerUiPath"
    }
    Write-Host "Starting Designer UI in watch mode..." -ForegroundColor Yellow
