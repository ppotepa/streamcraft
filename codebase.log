@font-face {
    font-family: 'Eurostile';
    src: url('./assets/eurostile.TTF') format('truetype');
    font-weight: normal;
    font-style: normal;
}

@import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap');

:root {
    /* Panel Colors */
    --panel-lightest: #D7FEEB;
    --panel-light: #10734F;
    --panel-mid: #0D4023;
    --panel-dark: #052E28;
    --panel-darkest: #0D0D0D;

    /* Graphics Colors */
    --graphics-bright: #0ABF04;
    --graphics-light: #078C03;
    --graphics-mid: #055902;
    --graphics-dark: #022601;

    /* Accent Colors */
    --accent-darkest: #000D0C;
    --accent-dark: #01261C;
    --accent-mid: #02734A;
    --accent-dark-mid: #014029;
    --accent-bright: #54BF8D;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Eurostile', 'Courier New', monospace;
    background: #000000;
    color: #fff;
    overflow: hidden;
}

#root {
    width: 100vw;
    height: 100vh;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
}

/* Canvas: 2400×500 overlay */
.overlay-canvas {
    width: 2400px;
    height: 500px;
    min-width: 2400px;
    min-height: 500px;
    display: flex;
    gap: 0;
    padding: 0;
    background: transparent;
    flex-shrink: 0;
}

/* Universal panel frame - CRT style */
.panel {
    width: 600px;
    height: 500px;
    min-width: 600px;
    min-height: 500px;
    background: var(--panel-darkest);
    border: 2px solid var(--accent-mid);
    border-radius: 0;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    overflow: hidden;
    flex-shrink: 0;
    position: relative;
    box-shadow:
        inset 0 0 60px rgba(2, 115, 74, 0.15),
        0 0 20px rgba(2, 115, 74, 0.3),
        0 0 40px rgba(1, 64, 41, 0.2);
    text-shadow: 0 0 0.2em currentColor,
        1px 1px rgba(255, 0, 255, 0.5),
        -1px -1px rgba(0, 255, 255, 0.4);
}

/* CRT scanline effect - horizontal RGB lines */
.panel::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(var(--crt-red) 0px,
            var(--crt-green) 2px,
            var(--crt-blue) 4px);
    pointer-events: none;
    z-index: 100;
    mix-blend-mode: overlay;
    transform: translateZ(0);
}

/* CRT glow effect - vertical RGB lines */
.panel::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(90deg,
            var(--crt-red) 1px,
            var(--crt-green) 2px,
            var(--crt-blue) 3px);
    border-radius: 8px;
    pointer-events: none;
    z-index: 100;
    mix-blend-mode: overlay;
    transform: translateZ(0);
}

@keyframes crt-glow {

    0%,
    100% {
        opacity: 0.5;
    }

    50% {
        opacity: 1;
    }
}

/* Panel title (small, uppercase, muted) - CRT green */
.panel-title {
    font-size: 20px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--panel-lightest);
    text-shadow: 0 0 0.2em currentColor,
        1px 1px rgba(215, 254, 235, 0.5),
        -1px -1px rgba(84, 191, 141, 0.4);
    position: relative;
    z-index: 101;
}

/* Universal strip component - CRT themed */
.strip {
    background: linear-gradient(135deg, rgba(1, 38, 28, 0.4) 0%, rgba(2, 115, 74, 0.2) 100%);
    border: 1px solid var(--accent-mid);
    border-radius: 6px;
    padding: 16px 20px;
    font-size: 20px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--accent-bright);
    position: relative;
    z-index: 101;
    box-shadow: inset 0 0 20px rgba(2, 115, 74, 0.1);
}

.strip-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.strip-3col {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 12px;
    text-align: center;
}

.strip-3col>*:first-child {
    text-align: left;
}

.strip-3col>*:last-child {
    text-align: right;
}

/* 4-column strip for enhanced layouts */
.strip-4col {
    display: grid;
    grid-template-columns: 2.5fr 1.5fr 1fr 1fr;
    gap: 12px;
    text-align: center;
}

.strip-4col>*:first-child {
    text-align: left;
}

.strip-4col>*:last-child {
    text-align: right;
}

/* Bold name styling */
.name-bold {
    font-weight: 700;
}

/* Stat cards (W/G/L row) - CRT themed */
.stat-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
}

.stat-card {
    background: linear-gradient(135deg, rgba(1, 38, 28, 0.5) 0%, rgba(2, 115, 74, 0.3) 100%);
    border: 1px solid var(--accent-mid);
    border-radius: 8px;
    padding: 16px 12px;
    text-align: center;
    position: relative;
    z-index: 101;
    box-shadow: inset 0 0 15px rgba(2, 115, 74, 0.15);
}

.stat-card-label {
    font-size: 15px;
    text-transform: uppercase;
