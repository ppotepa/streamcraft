/* Diagnostics Panel */
.diagnostics-panel {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-dark, #808080);
    background: var(--button-face, #c0c0c0);
}

.diagnostics-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 8px;
    border-bottom: 1px solid var(--border-dark, #808080);
    background: var(--button-face, #c0c0c0);
}

.diagnostics-title {
    font-weight: bold;
}

.diagnostics-body {
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-height: 200px;
    overflow: auto;
    background: white;
}

.diagnostics-item {
    border: 1px solid var(--border-dark, #808080);
    background: var(--button-face, #c0c0c0);
    padding: 6px;
}

.diagnostics-item.diagnostics-warning {
    border-color: #a67c00;
}

.diagnostics-item.diagnostics-error {
    border-color: #b00020;
}

.diagnostics-message {
    font-size: 12px;
}

.diagnostics-meta {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    opacity: 0.7;
}

.diagnostics-empty {
    font-size: 12px;
    opacity: 0.7;
}

/* Sample Badge (plugin demo) */
.sc-badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 6px;
    border: 1px solid var(--border-dark, #808080);
    background: var(--button-face, #c0c0c0);
    font-size: 11px;
    border-radius: 2px;
}

/* XML error fallback */
.xml-error {
    padding: 12px;
    border: 1px solid #b00020;
    background: #ffecec;
    color: #5f0a0a;
    font-size: 12px;
}

/* MessageBox Control */
.message-box-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 12px;
}

.message-box-content {
    display: flex;
    gap: 12px;
    align-items: flex-start;
}

.message-box-text {
    font-size: 13px;
    line-height: 1.4;
}

.message-box-actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
}

/* Icon helpers */
.sc-icon-inline {
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.tool-icon {
    display: inline-flex;
    width: 18px;
    height: 18px;
    align-items: center;
    justify-content: center;
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
}

.tool-icon-font {
    font-family: "Material Symbols Outlined", "Segoe UI Symbol", sans-serif;
    font-size: 18px;
    line-height: 1;
    font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 20;
}

.sc-icon-only .sc-icon-text {
    display: none;
}

.message-box-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
}

.message-box-icon-asset {
    width: 24px;
    height: 24px;
}

/* Layout canvas */
.layout-canvas {
    width: 100%;
    height: 100%;
    border: 3px solid #ffffff;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.3), 0 4px 12px rgba(0, 0, 0, 0.25);
    position: relative;
}

/* Canvas wrapper for centering and scaling */
.canvas-wrapper {
    position: relative;
    width: fit-content;
    height: fit-content;
    display: block;
}

.playground2-canvas-form {
    background: #2b2b2b;
}

/* Helper lines for canvas */
.layout-canvas::before,
.layout-canvas::after {
    content: "";
    position: absolute;
    pointer-events: none;
}

/* Vertical center line */
.layout-canvas::before {
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    background: rgba(255, 255, 255, 0.2);
    transform: translateX(-0.5px);
}

/* Horizontal center line */
.layout-canvas::after {
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-0.5px);
}

/* Toolbox */
.toolbox-body {
    padding: 8px;
}

.toolbox-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(80px, 1fr));
    gap: 6px;
}

.toolbox-item {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px;
}

.switch-button.is-checked {
    box-shadow: inset 1px 1px 0 rgba(0, 0, 0, 0.6), inset -1px -1px 0 rgba(255, 255, 255, 0.8);
    transform: translate(1px, 1px);
}

.toolbox-label {
    font-size: 12px;
}

.toolbox-empty {
    font-size: 12px;
    opacity: 0.7;
    padding-top: 6px;
}

/* Layout canvas items */
.canvas-item {
    position: absolute;
    min-width: 80px;
    min-height: 32px;
    padding: 6px 8px;
    background: transparent;
    color: #222;
    border: 1px solid rgba(0, 0, 0, 0.2);
    font-size: 12px;
    box-sizing: border-box;
}

.canvas-item-body {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.canvas-item-selected {
    outline: 2px solid #2b7cff;
}

.canvas-item-text {
    border-style: dashed;
}

.canvas-item-rect {
    background: transparent;
}

.canvas-item-ellipse {
    border-radius: 999px;
}

.canvas-item-line {
    min-height: 2px;
    height: 2px;
    padding: 0;
    width: 100px;
    background: rgba(0, 0, 0, 0.5);
}

.canvas-item-progress {
    padding: 4px;
    border: none;
    background: transparent;
}

.canvas-item-progress .progressbar {
    width: 100%;
    height: 100%;
}

.canvas-item-label {
    pointer-events: none;
    user-select: none;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.canvas-item-text .canvas-item-label {
    white-space: pre-wrap;
    overflow-wrap: break-word;
    word-break: break-word;
}

.canvas-item-image-placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 2px;
    background-color: #f5f5f5;
    color: #222;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-align: center;
    pointer-events: none;
    background-image:
        linear-gradient(#222, #222),
        linear-gradient(#222, #222),
        linear-gradient(#222, #222),
        linear-gradient(#222, #222),
        linear-gradient(#222, #222),
        linear-gradient(#222, #222),
        linear-gradient(#222, #222),
        linear-gradient(#222, #222);
    background-size:
        15% 2px,
        2px 15%,
        15% 2px,
        2px 15%,
        15% 2px,
        2px 15%,
        15% 2px,
        2px 15%;
    background-position:
        left top,
        left top,
        right top,
        right top,
        left bottom,
        left bottom,
        right bottom,
        right bottom;
    background-repeat: no-repeat;
}

.canvas-item-image-placeholder-text {
    line-height: 1.1;
}

.canvas-item-handles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 5;
    display: none;
}

.canvas-item-handle {
    position: absolute;
    width: 8px;
    height: 8px;
    background: #ffffff;
    border: 1px solid #2b7cff;
    box-sizing: border-box;
    pointer-events: auto;
}

.canvas-item-selected .canvas-item-handles {
    display: block;
}

.canvas-item-handle-nw {
    left: -5px;
    top: -5px;
    cursor: nwse-resize;
}

.canvas-item-handle-ne {
    right: -5px;
    top: -5px;
    cursor: nesw-resize;
}

.canvas-item-handle-sw {
    left: -5px;
    bottom: -5px;
    cursor: nesw-resize;
}

.canvas-item-handle-se {
    right: -5px;
    bottom: -5px;
    cursor: nwse-resize;
}

/* Canvas properties panel */
.canvas-properties {
    background: transparent;
    color: inherit;
    border: none;
    border-radius: 0;
    padding: 6px 4px;
    font-size: 12px;
}

.canvas-properties-title {
    font-weight: 600;
    margin-bottom: 8px;
}

.canvas-properties-empty {
    opacity: 0.75;
}

.canvas-properties-body {
    display: grid;
    gap: 8px;
}

.canvas-properties-section {
    display: grid;
    gap: 8px;
}

.canvas-properties-row {
    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 6px;
    align-items: center;
}

.canvas-properties-row label {
    font-size: 11px;
    opacity: 0.85;
}

.canvas-properties-row input {
    width: 100%;
    box-sizing: border-box;
    padding: 4px 6px;
    font-size: 12px;
}

.canvas-properties-row .checkbox-label {
    justify-self: start;
}

.canvas-properties-row .checkbox {
    width: auto;
    padding: 0;
}

.canvas-properties-row input[type="color"] {
    padding: 0;
    height: 24px;
}

.canvas-properties-button {
    grid-column: 2 / -1;
    justify-self: start;
    padding: 4px 8px;
    font-size: 11px;
    cursor: pointer;
}

.canvas-properties-readonly {
    padding: 4px 6px;
    background: rgba(0, 0, 0, 0.05);
    border-radius: 4px;
}

.canvas-properties-event {
    font-size: 11px;
    padding: 4px 6px;
    background: rgba(0, 0, 0, 0.05);
    border-radius: 4px;
}

.canvas-properties-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
}

/* Text styles dialog (win98) */
.text-styles-window {
    min-width: 920px;
    min-height: 640px;
    border-radius: 0;
    border: 2px groove #c0c0c0;
    background: #c0c0c0;
    box-shadow: none;
    overflow: hidden;
}

.text-styles-window .title-bar {
    background: #000080;
    border-bottom: 2px groove #c0c0c0;
    padding: 3px 6px;
    min-height: 22px;
    display: flex;
    align-items: center;
}

.text-styles-window .title-bar-text {
    font-weight: 700;
    color: #ffffff;
}

.text-styles-window .title-bar-controls button {
    width: 16px;
    height: 14px;
    min-width: 16px;
    min-height: 14px;
    border-radius: 0;
    background: #c0c0c0;
    border: 2px outset #ffffff;
    box-shadow: none;
}

.text-styles-window .window-body {
    padding: 0;
    background: #c0c0c0;
}

.text-styles-body {
    height: 100%;
}

.text-styles-shell {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 8px;
}

.text-styles-topbar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: flex-end;
    padding: 6px;
    border-radius: 0;
    background: #c0c0c0;
    border: 2px groove #c0c0c0;
}

.text-styles-field {
    display: grid;
    gap: 4px;
}

.text-styles-label {
    font-size: 11px;
    color: #1f2937;
}

.text-styles-window .textbox,
.text-styles-window .combobox {
    border-radius: 0;
    border: 2px inset #ffffff;
    padding: 4px 6px;
    background: #ffffff;
    font-size: 11px;
    color: #000000;
}

.text-styles-action {
    padding: 2px 10px;
    border-radius: 0;
    border: 2px outset #ffffff;
    background: #c0c0c0;
    font-size: 11px;
}

.text-styles-action-primary {
    font-weight: 700;
}

.text-styles-action-ai {
    font-weight: 600;
}

.text-styles-banner {
    padding: 0;
    border-radius: 0;
    border: 2px groove #c0c0c0;
    background: #c0c0c0;
    color: #000000;
    font-size: 11px;
}

.text-styles-banner.is-error {
    border-color: #800000;
    background: #c0c0c0;
    color: #800000;
}

.text-styles-banner.is-success {
    border-color: #006400;
    background: #c0c0c0;
    color: #006400;
}

.text-styles-sync {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: #1f2937;
}

.text-styles-ai-window .window-body {
    padding: 0;
}

.text-styles-ai-shell {
    height: 100%;
    display: grid;
    grid-template-rows: auto auto auto 1fr;
    gap: 8px;
    padding: 8px;
}

.text-styles-ai-header {
    display: grid;
    gap: 4px;
}

.text-styles-ai-title {
    font-size: 12px;
    font-weight: 700;
    color: #000000;
}

.text-styles-ai-sub {
    font-size: 11px;
    color: #404040;
}

.text-styles-ai-input {
    min-height: 120px;
    resize: vertical;
}

.text-styles-ai-actions {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
}

.text-styles-ai-output {
    padding: 8px;
    border-radius: 0;
    border: 2px inset #ffffff;
    background: #ffffff;
    overflow: auto;
    display: grid;
    gap: 8px;
}

.text-styles-ai-response {
    font-size: 11px;
    color: #000000;
    line-height: 1.5;
}

.text-styles-layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr) 320px;
    gap: 8px;
    flex: 1;
    min-height: 0;
}

.text-styles-sidebar {
    display: grid;
    gap: 8px;
    padding: 8px;
    border-radius: 0;
    background: #c0c0c0;
    border: 2px groove #c0c0c0;
    overflow: auto;
}

.text-styles-section-title {
    font-size: 11px;
    font-weight: 700;
    color: #000000;
}

.text-styles-category-list {
    display: grid;
    gap: 6px;
    padding: 6px;
}

.text-styles-category {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 6px;
    border-radius: 0;
    border: 1px solid transparent;
    background: transparent;
    font-size: 11px;
    cursor: pointer;
}

.text-styles-category.is-active {
    background: #000080;
    border-color: #000000;
    color: #ffffff;
}

.text-styles-category-label {
    font-weight: 600;
}

.text-styles-category-count {
    color: inherit;
}

.text-styles-filter {
    display: grid;
    gap: 6px;
}

.text-styles-filter-label {
    font-size: 11px;
    color: #404040;
}

.text-styles-grid {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 8px;
    padding: 8px;
    border-radius: 0;
    background: #c0c0c0;
    border: 2px groove #c0c0c0;
    min-height: 0;
}

.text-styles-grid-header,
.text-styles-grid-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
}

.text-styles-grid-title {
    font-weight: 700;
    color: #000000;
}

.text-styles-grid-meta {
    font-size: 11px;
    color: #404040;
}

.text-styles-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 6px;
    overflow: auto;
    padding: 6px;
}

.text-styles-card {
    display: grid;
    gap: 8px;
    padding: 6px;
    border-radius: 0;
    border: 1px solid #808080;
    background: #ffffff;
    cursor: pointer;
}

.text-styles-card.is-selected {
    border-color: #000000;
    background: #000080;
    color: #ffffff;
}

.text-styles-card.is-selected .text-styles-card-preview,
.text-styles-card.is-selected .text-styles-meta,
.text-styles-card.is-selected .text-styles-name,
.text-styles-card.is-selected .text-styles-tags {
    color: #ffffff;
}

.text-styles-card.is-selected .text-styles-chip {
    background: #000080;
    border-color: #ffffff;
    color: #ffffff;
}

.text-styles-favorite {
    font-size: 12px;
    color: #f59e0b;
}

.text-styles-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.text-styles-chip {
    padding: 2px 6px;
    border-radius: 0;
    font-size: 10px;
    font-weight: 600;
    background: #d7d7d7;
    border: 1px solid #808080;
}

.text-styles-chip--modern,
.text-styles-card--modern {
    background: #ffffff;
    border-color: #808080;
}

.text-styles-chip--retro,
.text-styles-card--retro {
    background: #ffffff;
    border-color: #808080;
}

.text-styles-chip--editorial,
.text-styles-card--editorial {
    background: #ffffff;
    border-color: #808080;
}

.text-styles-chip--neon,
.text-styles-card--neon {
    background: #ffffff;
    border-color: #808080;
}

.text-styles-chip--designer,
.text-styles-card--designer {
    background: #ffffff;
    border-color: #808080;
}

.text-styles-chip--overlay,
.text-styles-card--overlay {
    background: #ffffff;
    border-color: #808080;
}

.text-styles-chip--mono,
.text-styles-card--mono {
    background: #ffffff;
    border-color: #808080;
}

.text-styles-info {
    display: grid;
    gap: 4px;
    min-width: 0;
}

.text-styles-card-preview {
    font-size: 14px;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.text-styles-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 11px;
    color: #404040;
}

.text-styles-name {
    font-weight: 600;
    color: inherit;
}

.text-styles-tags {
    opacity: 0.85;
}

.text-styles-apply {
    justify-self: flex-end;
}

.text-styles-preview {
    display: grid;
    gap: 8px;
    padding: 8px;
    border-radius: 0;
    background: #c0c0c0;
    border: 2px groove #c0c0c0;
    overflow: auto;
}

.text-styles-preview-meta {
    font-size: 11px;
    color: #404040;
}

.text-styles-preview-box {
    padding: 8px;
    border-radius: 0;
    background: #ffffff;
    border: 2px inset #ffffff;
    font-size: 14px;
    color: #000000;
}

.text-styles-textarea {
    min-height: 70px;
}

.text-styles-charmap {
    padding: 6px;
    border-radius: 0;
    background: #ffffff;
    border: 2px inset #ffffff;
    font-family: Consolas, "Courier New", monospace;
    font-size: 11px;
    color: #000000;
    line-height: 1.6;
}

.text-styles-preview-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

/* Data Source Explorer */
.data-source-explorer {
    display: grid;
    gap: 10px;
    min-width: 640px;
}

.data-source-explorer-body {
    display: grid;
    gap: 10px;
}

.data-source-explorer-main {
    display: grid;
    gap: 12px;
}

.data-source-explorer-grid {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 10px;
    min-height: 240px;
}

.data-source-explorer-panel {
    border: 1px solid var(--border-dark, #808080);
    background: var(--button-face, #c0c0c0);
    padding: 6px;
    display: grid;
    gap: 6px;
    min-height: 200px;
}

.data-source-explorer-title {
    font-weight: 600;
    font-size: 12px;
}

.data-source-explorer-fields {
    border: 1px solid var(--border-dark, #808080);
    background: #f7f7f7;
    padding: 4px;
    overflow: auto;
    max-height: 280px;
}

.data-source-explorer-field {
    padding: 3px 6px;
    border-radius: 3px;
    cursor: pointer;
    font-size: 11px;
}

.data-source-explorer-field.is-container {
    opacity: 0.6;
    cursor: default;
}

.data-source-explorer-field.is-active {
    background: rgba(0, 0, 0, 0.12);
    font-weight: 600;
}

.data-source-explorer-preview {
    max-height: 280px;
    overflow: auto;
    background: #f7f7f7;
    border: 1px solid var(--border-dark, #808080);
    padding: 6px;
    font-size: 11px;
    font-family: Consolas, "Courier New", monospace;
    white-space: pre-wrap;
}

.data-source-explorer-footer {
    border-top: 1px solid var(--border-dark, #808080);
    padding-top: 6px;
    display: grid;
    gap: 6px;
}

.json-node {
    margin-left: 0;
}

.json-node summary {
    cursor: pointer;
    list-style: none;
    font-weight: 600;
}

.json-node summary::-webkit-details-marker {
    display: none;
}

.json-node-summary::before {
    content: "▸";
    display: inline-block;
    margin-right: 6px;
}

details[open]>.json-node-summary::before {
    content: "▾";
}

.json-node-children {
    padding-left: 14px;
    display: grid;
    gap: 3px;
}

.json-leaf {
    display: flex;
    gap: 4px;
}

.json-leaf-key {
    color: #1f3d7a;
}

.json-leaf-sep {
    opacity: 0.6;
}

.json-leaf-value {
    color: #333333;
}

.designer-status-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 26px;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr auto auto;
    align-items: center;
    gap: 8px;
    padding: 0 8px;
    background: var(--button-face, #c0c0c0);
    border-top: 1px solid var(--border-dark, #808080);
    font-size: 11px;
    box-sizing: border-box;
    z-index: 900;
}

.designer-status-cell {
    padding: 2px 6px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.designer-status-cell-right {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 6px;
