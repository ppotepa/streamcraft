.status-pill {
  padding: 6px 12px;
  border-radius: 999px;
  background: rgba(47, 230, 168, 0.2);
  color: var(--accent);
  border: 1px solid rgba(47, 230, 168, 0.5);
  font-size: 0.75rem;
}

.palette-strip {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: minmax(200px, 1fr);
  gap: 16px;
  overflow-x: auto;
  padding-bottom: 8px;
}

.palette-card {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 14px;
  align-items: center;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 16px;
  background: rgba(14, 20, 28, 0.7);
  padding: 14px;
  text-align: left;
  cursor: grab;
  transition: transform 0.2s ease, border-color 0.2s ease;
}

.palette-card:hover {
  transform: translateY(-2px);
  border-color: rgba(47, 230, 168, 0.5);
}

.palette-preview {
  width: 54px;
  height: 54px;
  border-radius: 12px;
  display: grid;
  gap: 4px;
  padding: 8px;
  background: rgba(255, 255, 255, 0.08);
}

.palette-preview span {
  display: block;
  height: 6px;
  border-radius: 999px;
  background: var(--accent-3);
}

.palette-preview[data-widget="image"] span {
  height: 100%;
  border-radius: 8px;
  background: linear-gradient(135deg, #2dd4ff 0%, #2fe6a8 100%);
}

.palette-preview[data-widget="marquee"] span {
  background: linear-gradient(90deg, #2fe6a8, #2dd4ff);
}

.palette-info h4 {
  margin: 0 0 4px 0;
  font-size: 1rem;
}

.palette-info p {
  margin: 0 0 6px 0;
  font-size: 0.85rem;
  color: var(--muted);
}

.palette-info span {
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--accent-3);
}

.canvas-stage {
  position: relative;
  border-radius: 18px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)), url("../res/preview.jpg");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  margin: 0 auto;
  overflow: hidden;
  /* Fill container while maintaining aspect ratio */
  width: 100%;
  max-width: 1920px;
  aspect-ratio: 16 / 9;
}

.canvas-stage.grid-on::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image: linear-gradient(var(--grid) 1px, transparent 1px),
    linear-gradient(90deg, var(--grid) 1px, transparent 1px);
  background-size: 16px 16px;
  pointer-events: none;
}

.canvas-root {
  position: absolute;
  inset: 0;
}

.safe-zone {
  position: absolute;
  inset: 6% 6% 6% 6%;
  border: 1px dashed rgba(255, 255, 255, 0.3);
  border-radius: 12px;
  pointer-events: none;
}

.overlay-widget {
  position: absolute;
  display: grid;
  grid-template-rows: auto 1fr auto;
  gap: 8px;
  padding: 12px;
  border-radius: 16px;
  border: 1px solid rgba(255, 255, 255, 0.15);
  background: rgba(9, 14, 20, 0.78);
  box-shadow: 0 16px 30px rgba(0, 0, 0, 0.35);
  color: var(--text);
}

.overlay-text {
  grid-template-rows: 1fr;
  gap: 0;
  padding: 0;
  border: none;
  background: transparent;
  box-shadow: none;
  color: var(--text);
}

.overlay-text .widget-body {
  justify-content: flex-start;
  align-items: flex-start;
  font-size: 1.5rem;
  font-weight: 600;
  line-height: 1.2;
  padding: 0;
}

.overlay-widget.is-selected {
  border-color: rgba(47, 230, 168, 0.6);
  box-shadow: 0 0 0 2px rgba(47, 230, 168, 0.2), 0 18px 35px rgba(0, 0, 0, 0.4);
}

.widget-header {
  display: flex;
  align-items: center;
