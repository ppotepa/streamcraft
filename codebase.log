            onMouseMove: this.onMouseMove,
            onMouseUp: this.onMouseUp,
            onWheel: this.onWheel,
            className: this.className,
            style: this.style
        };

        if (this.width) {
            props.width = this.width;
        }

        if (this.height) {
            props.height = this.height;
        }

