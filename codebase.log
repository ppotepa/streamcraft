}

.dock-panel::-webkit-scrollbar-button:vertical:decrement {
    background: #c0c0c0 url("data:image/svg+xml;charset=utf-8,%3Csvg width='16' height='16' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M8 6l-4 4h8z' fill='%23000'/%3E%3C/svg%3E") center no-repeat;
}

.dock-panel::-webkit-scrollbar-button:vertical:increment {
    background: #c0c0c0 url("data:image/svg+xml;charset=utf-8,%3Csvg width='16' height='16' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M8 10l-4-4h8z' fill='%23000'/%3E%3C/svg%3E") center no-repeat;
}

/* FlowLayoutPanel Control */
.flow-layout-panel {
    box-sizing: border-box;
}

/* TableLayoutPanel Control */
.table-layout-panel {
    box-sizing: border-box;
}

/* GroupBox Control */
.group-box {
    border: 2px groove var(--border-dark, #808080);
    padding: 10px;
    margin: 0;
}

.group-box-legend {
    padding: 0 5px;
    font-weight: bold;
}

.group-box-collapsible .group-box-legend {
    padding: 0;
}

.group-box-legend-button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0 5px;
    border: none;
    background: transparent;
    font: inherit;
    cursor: pointer;
}

.group-box-legend-button:focus-visible {
    outline: 1px dashed var(--border-dark, #808080);
    outline-offset: 2px;
}

.group-box-legend-caret {
    font-size: 12px;
    line-height: 1;
}

.group-box-disabled {
    opacity: 0.6;
}

.group-box-content {
    margin-top: 8px;
}

/* SplitContainer Control */
.split-container {
    box-sizing: border-box;
}

.split-panel {
    box-sizing: border-box;
    min-width: 0;
    min-height: 0;
}

.split-splitter {
    flex-shrink: 0;
    user-select: none;
}

.split-splitter:hover {
    background: var(--button-highlight, #dfdfdf);
}

.split-splitter:active {
    background: var(--button-shadow, #808080);
}

/* ComboBox Control */
.combobox {
    box-sizing: border-box;
    padding: 4px 6px;
    font-family: inherit;
    font-size: inherit;
    min-width: 100px;
}

.combobox:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

/* ListBox Control */
.listbox {
    box-sizing: border-box;
    padding: 4px;
    font-family: inherit;
    font-size: inherit;
    min-width: 100px;
}

.listbox:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

.listbox option {
    padding: 2px 4px;
}

/* ProgressBar Control */
.progressbar {
    width: 200px;
    height: 20px;
    border: 1px solid var(--border-dark, #808080);
    background: var(--button-face, #c0c0c0);
    position: relative;
    overflow: hidden;
}

.progressbar-fill {
    height: 100%;
    background: linear-gradient(to right, #0078d7, #0063b1);
    transition: width 0.3s ease;
}

.progressbar-blocks .progressbar-blocks-pattern {
    background: repeating-linear-gradient(90deg,
            transparent,
            transparent 8px,
            rgba(255, 255, 255, 0.3) 8px,
            rgba(255, 255, 255, 0.3) 10px);
    width: 100%;
    height: 100%;
}

/* TrackBar Control */
.trackbar-container {
    display: inline-flex;
}

.trackbar {
    -webkit-appearance: none;
    appearance: none;
    background: transparent;
}

.trackbar::-webkit-slider-track {
    background: var(--button-face, #c0c0c0);
    border: 1px solid var(--border-dark, #808080);
    height: 6px;
}

.trackbar::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 16px;
    height: 16px;
    background: var(--button-face, #c0c0c0);
    border: 1px solid var(--border-dark, #808080);
    cursor: pointer;
    margin-top: -5px;
}

.trackbar::-moz-range-track {
    background: var(--button-face, #c0c0c0);
    border: 1px solid var(--border-dark, #808080);
    height: 6px;
}

.trackbar::-moz-range-thumb {
    width: 16px;
    height: 16px;
    background: var(--button-face, #c0c0c0);
    border: 1px solid var(--border-dark, #808080);
    cursor: pointer;
}

.trackbar:disabled::-webkit-slider-thumb {
    cursor: not-allowed;
    opacity: 0.6;
}

.trackbar:disabled::-moz-range-thumb {
    cursor: not-allowed;
    opacity: 0.6;
}

.trackbar-value {
    font-size: 12px;
    color: var(--text-color, #000);
    user-select: none;
}

/* TabControl */
.tab-control {
    box-sizing: border-box;
    border: 1px solid var(--border-dark, #808080);
    background: var(--button-face, #c0c0c0);
}

.tab-control>menu[role=tablist] {
    display: flex;
    list-style-type: none;
    margin: 0 0 -2px;
    padding-left: 3px;
    position: relative;
    text-indent: 0;
}

.tab-control>menu[role=tablist].multirows {
    flex-wrap: wrap;
}

.tab-control>menu[role=tablist]>li[role=tab] {
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    box-shadow: inset -1px 0 #0a0a0a, inset 1px 1px #dfdfdf, inset -2px 0 grey, inset 2px 2px #fff;
    padding: 4px 8px;
    margin: 0 2px 0 0;
    cursor: default;
    user-select: none;
    z-index: 1;
}

.tab-control>menu[role=tablist]>li[role=tab][aria-selected="true"] {
    background-color: silver;
    margin-left: -3px;
    margin-top: -2px;
    padding-bottom: 2px;
    position: relative;
    z-index: 8;
}

.tab-control-content {
    padding: 10px;
    background: white;
}

.properties-container .tab-control {
    border: none;
    background: transparent;
}

.properties-container .tab-control-header {
    border-bottom: 1px solid var(--border-dark, #808080);
    background: var(--button-face, #c0c0c0);
}

.properties-container .tab-control-content {
    padding: 8px 6px;
    background: transparent;
}

.tab-page {
    box-sizing: border-box;
}

/* Diagnostics Panel */
.diagnostics-panel {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-dark, #808080);
    background: var(--button-face, #c0c0c0);
}

.diagnostics-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 8px;
    border-bottom: 1px solid var(--border-dark, #808080);
    background: var(--button-face, #c0c0c0);
}

.diagnostics-title {
    font-weight: bold;
}

.diagnostics-body {
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-height: 200px;
    overflow: auto;
    background: white;
}

.diagnostics-item {
    border: 1px solid var(--border-dark, #808080);
    background: var(--button-face, #c0c0c0);
    padding: 6px;
}

.diagnostics-item.diagnostics-warning {
    border-color: #a67c00;
}

.diagnostics-item.diagnostics-error {
    border-color: #b00020;
}

.diagnostics-message {
    font-size: 12px;
}

.diagnostics-meta {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    opacity: 0.7;
}

.diagnostics-empty {
    font-size: 12px;
    opacity: 0.7;
}

/* Sample Badge (plugin demo) */
.sc-badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 6px;
    border: 1px solid var(--border-dark, #808080);
    background: var(--button-face, #c0c0c0);
    font-size: 11px;
    border-radius: 2px;
}

/* XML error fallback */
.xml-error {
    padding: 12px;
    border: 1px solid #b00020;
    background: #ffecec;
    color: #5f0a0a;
    font-size: 12px;
}

/* MessageBox Control */
.message-box-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 12px;
}

.message-box-content {
    display: flex;
    gap: 12px;
    align-items: flex-start;
}

.message-box-text {
    font-size: 13px;
    line-height: 1.4;
}

.message-box-actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
}

/* Icon helpers */
.sc-icon-inline {
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.tool-icon {
    display: inline-flex;
    width: 18px;
    height: 18px;
    align-items: center;
    justify-content: center;
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
}

.tool-icon-font {
    font-family: "Material Symbols Outlined", "Segoe UI Symbol", sans-serif;
    font-size: 18px;
    line-height: 1;
    font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 20;
}

.sc-icon-only .sc-icon-text {
    display: none;
}

.message-box-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
}

.message-box-icon-asset {
    width: 24px;
    height: 24px;
}

/* Layout canvas */
.layout-canvas {
    width: 100%;
    height: 100%;
    border: 3px solid #ffffff;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.3), 0 4px 12px rgba(0, 0, 0, 0.25);
    position: relative;
}

/* Canvas wrapper for centering and scaling */
.canvas-wrapper {
    position: relative;
    width: fit-content;
    height: fit-content;
    display: block;
}

.playground2-canvas-form {
    background: #2b2b2b;
}

/* Helper lines for canvas */
.layout-canvas::before,
.layout-canvas::after {
    content: "";
    position: absolute;
    pointer-events: none;
}

/* Vertical center line */
.layout-canvas::before {
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    background: rgba(255, 255, 255, 0.2);
    transform: translateX(-0.5px);
}

/* Horizontal center line */
.layout-canvas::after {
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-0.5px);
}

/* Toolbox */
.toolbox-body {
    padding: 8px;
}

.toolbox-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(80px, 1fr));
    gap: 6px;
}

.toolbox-item {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px;
}

.switch-button.is-checked {
    box-shadow: inset 1px 1px 0 rgba(0, 0, 0, 0.6), inset -1px -1px 0 rgba(255, 255, 255, 0.8);
    transform: translate(1px, 1px);
}

.toolbox-label {
    font-size: 12px;
}

.toolbox-empty {
    font-size: 12px;
    opacity: 0.7;
    padding-top: 6px;
}

/* Layout canvas items */
.canvas-item {
    position: absolute;
    min-width: 80px;
    min-height: 32px;
    padding: 6px 8px;
    background: transparent;
    color: #222;
    border: 1px solid rgba(0, 0, 0, 0.2);
    font-size: 12px;
    box-sizing: border-box;
}

.canvas-item-selected {
    outline: 2px solid #2b7cff;
}

.canvas-item-text {
    border-style: dashed;
}

.canvas-item-rect {
    background: transparent;
}

.canvas-item-ellipse {
    border-radius: 999px;
}

.canvas-item-line {
    min-height: 2px;
    height: 2px;
    padding: 0;
    width: 100px;
    background: rgba(0, 0, 0, 0.5);
}

.canvas-item-progress {
    padding: 4px;
    border: none;
    background: transparent;
}

.canvas-item-progress .progressbar {
    width: 100%;
    height: 100%;
}

.canvas-item-label {
    pointer-events: none;
    user-select: none;
}

.canvas-item-handles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 5;
    display: none;
}

.canvas-item-handle {
    position: absolute;
    width: 8px;
    height: 8px;
    background: #ffffff;
    border: 1px solid #2b7cff;
    box-sizing: border-box;
    pointer-events: auto;
}

.canvas-item-selected .canvas-item-handles {
    display: block;
}

.canvas-item-handle-nw {
    left: -5px;
    top: -5px;
    cursor: nwse-resize;
}

.canvas-item-handle-ne {
    right: -5px;
    top: -5px;
    cursor: nesw-resize;
}

.canvas-item-handle-sw {
    left: -5px;
    bottom: -5px;
    cursor: nesw-resize;
}

.canvas-item-handle-se {
    right: -5px;
    bottom: -5px;
    cursor: nwse-resize;
}

/* Canvas properties panel */
.canvas-properties {
    background: transparent;
    color: inherit;
    border: none;
    border-radius: 0;
    padding: 6px 4px;
    font-size: 12px;
}

.canvas-properties-title {
    font-weight: 600;
    margin-bottom: 8px;
}

.canvas-properties-empty {
    opacity: 0.75;
}

.canvas-properties-body {
    display: grid;
    gap: 8px;
}

.canvas-properties-section {
    display: grid;
    gap: 8px;
}

.canvas-properties-row {
    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 6px;
    align-items: center;
}

.canvas-properties-row label {
    font-size: 11px;
    opacity: 0.85;
}

.canvas-properties-row input {
    width: 100%;
    box-sizing: border-box;
    padding: 4px 6px;
    font-size: 12px;
}

.canvas-properties-row .checkbox-label {
    justify-self: start;
}

.canvas-properties-row .checkbox {
    width: auto;
    padding: 0;
}

.canvas-properties-row input[type="color"] {
    padding: 0;
    height: 24px;
}

.canvas-properties-button {
    grid-column: 2 / -1;
    justify-self: start;
    padding: 4px 8px;
    font-size: 11px;
    cursor: pointer;
}

.canvas-properties-readonly {
    padding: 4px 6px;
    background: rgba(0, 0, 0, 0.05);
    border-radius: 4px;
}

.canvas-properties-event {
    font-size: 11px;
    padding: 4px 6px;
    background: rgba(0, 0, 0, 0.05);
    border-radius: 4px;
}

.canvas-properties-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
}

/* Text styles dialog (win98) */
.text-styles-window {
    min-width: 920px;
    min-height: 640px;
    border-radius: 0;
    border: 2px groove #c0c0c0;
    background: #c0c0c0;
    box-shadow: none;
    overflow: hidden;
}

.text-styles-window .title-bar {
    background: #000080;
    border-bottom: 2px groove #c0c0c0;
    padding: 3px 6px;
    min-height: 22px;
    display: flex;
    align-items: center;
}

.text-styles-window .title-bar-text {
    font-weight: 700;
    color: #ffffff;
}

.text-styles-window .title-bar-controls button {
    width: 16px;
    height: 14px;
    min-width: 16px;
    min-height: 14px;
    border-radius: 0;
    background: #c0c0c0;
    border: 2px outset #ffffff;
    box-shadow: none;
}

.text-styles-window .window-body {
    padding: 0;
    background: #c0c0c0;
}

.text-styles-body {
    height: 100%;
}

.text-styles-shell {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 8px;
}

.text-styles-topbar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: flex-end;
    padding: 6px;
    border-radius: 0;
    background: #c0c0c0;
    border: 2px groove #c0c0c0;
}

.text-styles-field {
    display: grid;
    gap: 4px;
}

.text-styles-label {
    font-size: 11px;
    color: #1f2937;
}

.text-styles-window .textbox,
.text-styles-window .combobox {
    border-radius: 0;
    border: 2px inset #ffffff;
    padding: 4px 6px;
    background: #ffffff;
    font-size: 11px;
    color: #000000;
}

.text-styles-action {
    padding: 2px 10px;
    border-radius: 0;
    border: 2px outset #ffffff;
    background: #c0c0c0;
    font-size: 11px;
}

.text-styles-action-primary {
    font-weight: 700;
}

.text-styles-action-ai {
    font-weight: 600;
}

.text-styles-banner {
    padding: 0;
    border-radius: 0;
    border: 2px groove #c0c0c0;
    background: #c0c0c0;
    color: #000000;
    font-size: 11px;
}

.text-styles-banner.is-error {
    border-color: #800000;
    background: #c0c0c0;
    color: #800000;
}

.text-styles-banner.is-success {
    border-color: #006400;
    background: #c0c0c0;
    color: #006400;
}

.text-styles-sync {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: #1f2937;
}

.text-styles-ai-window .window-body {
    padding: 0;
}

.text-styles-ai-shell {
    height: 100%;
    display: grid;
    grid-template-rows: auto auto auto 1fr;
    gap: 8px;
    padding: 8px;
}

.text-styles-ai-header {
    display: grid;
    gap: 4px;
}

.text-styles-ai-title {
    font-size: 12px;
    font-weight: 700;
    color: #000000;
}

.text-styles-ai-sub {
    font-size: 11px;
    color: #404040;
}

.text-styles-ai-input {
    min-height: 120px;
    resize: vertical;
}

.text-styles-ai-actions {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
}

.text-styles-ai-output {
    padding: 8px;
    border-radius: 0;
    border: 2px inset #ffffff;
    background: #ffffff;
    overflow: auto;
    display: grid;
    gap: 8px;
}

.text-styles-ai-response {
    font-size: 11px;
    color: #000000;
    line-height: 1.5;
}

.text-styles-layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr) 320px;
    gap: 8px;
    flex: 1;
    min-height: 0;
}

.text-styles-sidebar {
    display: grid;
    gap: 8px;
    padding: 8px;
    border-radius: 0;
    background: #c0c0c0;
    border: 2px groove #c0c0c0;
    overflow: auto;
}

.text-styles-section-title {
    font-size: 11px;
    font-weight: 700;
    color: #000000;
}

.text-styles-category-list {
    display: grid;
    gap: 6px;
    padding: 6px;
}

.text-styles-category {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 6px;
    border-radius: 0;
    border: 1px solid transparent;
    background: transparent;
    font-size: 11px;
    cursor: pointer;
}

.text-styles-category.is-active {
    background: #000080;
    border-color: #000000;
    color: #ffffff;
}

.text-styles-category-label {
    font-weight: 600;
}

.text-styles-category-count {
    color: inherit;
}

.text-styles-filter {
    display: grid;
    gap: 6px;
}

.text-styles-filter-label {
    font-size: 11px;
    color: #404040;
}

.text-styles-grid {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 8px;
    padding: 8px;
    border-radius: 0;
    background: #c0c0c0;
    border: 2px groove #c0c0c0;
    min-height: 0;
}

.text-styles-grid-header,
.text-styles-grid-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
}

.text-styles-grid-title {
    font-weight: 700;
    color: #000000;
}

.text-styles-grid-meta {
    font-size: 11px;
    color: #404040;
}

.text-styles-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 6px;
    overflow: auto;
    padding: 6px;
}

.text-styles-card {
    display: grid;
    gap: 8px;
    padding: 6px;
    border-radius: 0;
    border: 1px solid #808080;
    background: #ffffff;
    cursor: pointer;
}

.text-styles-card.is-selected {
    border-color: #000000;
    background: #000080;
    color: #ffffff;
}

.text-styles-card.is-selected .text-styles-card-preview,
.text-styles-card.is-selected .text-styles-meta,
.text-styles-card.is-selected .text-styles-name,
.text-styles-card.is-selected .text-styles-tags {
    color: #ffffff;
}

.text-styles-card.is-selected .text-styles-chip {
    background: #000080;
    border-color: #ffffff;
    color: #ffffff;
}

.text-styles-favorite {
    font-size: 12px;
    color: #f59e0b;
}

.text-styles-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.text-styles-chip {
    padding: 2px 6px;
    border-radius: 0;
    font-size: 10px;
    font-weight: 600;
    background: #d7d7d7;
    border: 1px solid #808080;
}

.text-styles-chip--modern,
.text-styles-card--modern {
    background: #ffffff;
    border-color: #808080;
}

.text-styles-chip--retro,
.text-styles-card--retro {
    background: #ffffff;
    border-color: #808080;
}

.text-styles-chip--editorial,
.text-styles-card--editorial {
    background: #ffffff;
    border-color: #808080;
}

.text-styles-chip--neon,
.text-styles-card--neon {
    background: #ffffff;
    border-color: #808080;
}

.text-styles-chip--designer,
.text-styles-card--designer {
    background: #ffffff;
    border-color: #808080;
}

.text-styles-chip--overlay,
.text-styles-card--overlay {
    background: #ffffff;
    border-color: #808080;
}

.text-styles-chip--mono,
.text-styles-card--mono {
    background: #ffffff;
    border-color: #808080;
}

