.toggle {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.85rem;
  color: var(--muted);
}

.toggle input {
  accent-color: var(--accent);
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  border-radius: 999px;
  border: 1px solid var(--stroke);
  font-size: 0.75rem;
  color: var(--muted);
  background: rgba(8, 12, 16, 0.4);
}

.chip-muted {
  opacity: 0.6;
}

.status-pill {
  padding: 6px 12px;
  border-radius: 999px;
  background: rgba(47, 230, 168, 0.2);
  color: var(--accent);
  border: 1px solid rgba(47, 230, 168, 0.5);
  font-size: 0.75rem;
}

.palette-strip {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: minmax(200px, 1fr);
  gap: 16px;
  overflow-x: auto;
  padding-bottom: 8px;
}

.palette-card {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 14px;
  align-items: center;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 16px;
  background: rgba(14, 20, 28, 0.7);
  padding: 14px;
  text-align: left;
  cursor: grab;
  transition: transform 0.2s ease, border-color 0.2s ease;
}

.palette-card:hover {
  transform: translateY(-2px);
  border-color: rgba(47, 230, 168, 0.5);
}

.palette-preview {
  width: 54px;
  height: 54px;
  border-radius: 12px;
  display: grid;
  gap: 4px;
  padding: 8px;
  background: rgba(255, 255, 255, 0.08);
}

.palette-preview span {
  display: block;
  height: 6px;
  border-radius: 999px;
  background: var(--accent-3);
}

.palette-preview[data-widget="image"] span {
  height: 100%;
  border-radius: 8px;
  background: linear-gradient(135deg, #2dd4ff 0%, #2fe6a8 100%);
}

.palette-preview[data-widget="marquee"] span {
  background: linear-gradient(90deg, #2fe6a8, #2dd4ff);
}

.palette-info h4 {
  margin: 0 0 4px 0;
  font-size: 1rem;
}

.palette-info p {
  margin: 0 0 6px 0;
  font-size: 0.85rem;
  color: var(--muted);
}

.palette-info span {
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--accent-3);
}

.canvas-stage {
  position: relative;
  border-radius: 18px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)), url("../res/preview.jpg");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  margin: 0 auto;
  overflow: hidden;
  /* Fill container while maintaining aspect ratio */
  width: 100%;
  max-width: 1920px;
  aspect-ratio: 16 / 9;
}

.canvas-stage.grid-on::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image: linear-gradient(var(--grid) 1px, transparent 1px),
    linear-gradient(90deg, var(--grid) 1px, transparent 1px);
  background-size: 16px 16px;
  pointer-events: none;
}

.canvas-root {
  position: absolute;
  inset: 0;
}

.safe-zone {
  position: absolute;
  inset: 6% 6% 6% 6%;
  border: 1px dashed rgba(255, 255, 255, 0.3);
  border-radius: 12px;
  pointer-events: none;
}

.overlay-widget {
  position: absolute;
  display: grid;
  grid-template-rows: auto 1fr auto;
  gap: 8px;
  padding: 12px;
  border-radius: 16px;
  border: 1px solid rgba(255, 255, 255, 0.15);
  background: rgba(9, 14, 20, 0.78);
  box-shadow: 0 16px 30px rgba(0, 0, 0, 0.35);
  color: var(--text);
}

.overlay-text {
  grid-template-rows: 1fr;
  gap: 0;
  padding: 0;
  border: none;
  background: transparent;
  box-shadow: none;
  color: var(--text);
}

.overlay-text .widget-body {
  justify-content: flex-start;
  align-items: flex-start;
  font-size: 1.5rem;
  font-weight: 600;
  line-height: 1.2;
  padding: 0;
}

.overlay-widget.is-selected {
  border-color: rgba(47, 230, 168, 0.6);
  box-shadow: 0 0 0 2px rgba(47, 230, 168, 0.2), 0 18px 35px rgba(0, 0, 0, 0.4);
}

.widget-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.widget-kicker {
  margin: 0 0 2px 0;
  font-size: 0.65rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--accent-3);
}

.widget-header h3 {
  margin: 0;
  font-size: 1rem;
}

.widget-spark {
  display: flex;
  align-items: flex-end;
  gap: 3px;
}

.widget-spark span {
  width: 3px;
  border-radius: 3px;
  background: var(--accent);
}

.widget-body {
  font-size: 0.9rem;
  color: var(--text);
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  white-space: pre-wrap;
}

.widget-body img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 10px;
}

.overlay-marquee .widget-body {
  justify-content: flex-start;
}

.marquee {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.marquee-track {
  display: inline-flex;
  gap: 32px;
  align-items: center;
  min-width: 100%;
  animation: marquee-scroll 12s linear infinite;
}

.marquee-track span {
  white-space: nowrap;
}

@keyframes marquee-scroll {
  from {
    transform: translateX(0);
  }

  to {
    transform: translateX(-50%);
  }
}

.value-card {
  display: flex;
  flex-direction: column;
  gap: 6px;
  align-items: center;
}

.value-card-label {
  font-size: 0.7rem;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.progress-shell {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 6px;
  align-items: center;
}

.progress-track {
  width: 100%;
  height: 8px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.08);
}

.progress-fill {
  height: 100%;
  border-radius: 999px;
  background: linear-gradient(90deg, #2dd4ff, #2fe6a8);
}

.widget-binding {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 6px;
}

.widget-binding select {
  background: rgba(8, 12, 16, 0.9);
  border: 1px solid rgba(255, 255, 255, 0.18);
  color: var(--text);
  border-radius: 8px;
  padding: 4px 6px;
  font-size: 0.7rem;
}

.widget-binding select:focus {
  outline: none;
  border-color: rgba(47, 230, 168, 0.6);
}

.footer-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 18px;
}

.metadata-panel,
.response-panel {
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 16px;
  background: rgba(10, 16, 22, 0.6);
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 0.85rem;
  color: var(--muted);
}

.metadata-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  max-height: 240px;
  overflow: auto;
}

.metadata-row {
  display: grid;
  grid-template-columns: 1.4fr 0.6fr 1fr;
  gap: 8px;
  font-size: 0.75rem;
  align-items: center;
}

.field-path {
  color: var(--text);
}

.field-type {
  color: var(--accent-3);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 0.65rem;
}

.field-type.is-container {
  color: var(--accent-2);
}

.field-example {
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.response-body {
  flex: 1;
  background: rgba(8, 12, 16, 0.7);
  border-radius: 12px;
  padding: 12px;
  overflow: auto;
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.response-body pre {
  margin: 0;
  font-size: 0.75rem;
  color: var(--text);
}

.muted {
  color: var(--muted);
  font-size: 0.85rem;
}

.preview-modal {
  position: fixed;
  inset: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(6, 10, 14, 0.7);
  backdrop-filter: blur(6px);
}

.preview-window {
  position: relative;
  width: min(1100px, 90vw);
  height: min(620px, 80vh);
  border-radius: 18px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  overflow: hidden;
  background: #0b1116;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 18px;
  gap: 12px;
  box-shadow: var(--shadow);
}

.preview-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.55;
}

.preview-overlay {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
}

.preview-overlay .overlay-widget {
  pointer-events: none;
}

.designer-loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 2147483647;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(160, 160, 160, 0.6);
  backdrop-filter: grayscale(1) contrast(0.85);
  pointer-events: all;
}

.designer-loading-window {
  width: min(420px, 86vw);
  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.25);
  z-index: 1;
}

.designer-loading-body {
  display: grid;
  gap: 10px;
  padding: 12px;
}

.designer-loading-step {
  font-weight: 600;
  color: #1b1b1b;
}

.designer-loading-log {
  display: grid;
  gap: 2px;
  font-size: 12px;
  color: #3a3a3a;
  max-height: 120px;
  overflow: hidden;
}

.designer-loading-log-entry::before {
  content: "• ";
}

@media (max-width: 1000px) {
  .designer-app {
    padding: 16px;
  }

  .app-header {
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-grid {
    grid-template-columns: 1fr;
  }

  .widget-binding {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

.moveable-control-box {
  --moveable-color: var(--accent);
}

.moveable-control-box .moveable-line {
  background: var(--accent);
}

.moveable-control-box .moveable-control {
  width: 10px !important;
  height: 10px !important;
  border-radius: 50%;
  background: var(--accent);
  border: 2px solid #0b1116;
  box-shadow: 0 0 0 1px rgba(47, 230, 168, 0.4);
}

.moveable-control-box .moveable-rotation {
  background: var(--accent-3);
}

/* Widget editor modal */
.editor-modal {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.editor-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(6, 10, 14, 0.75);
  backdrop-filter: blur(8px);
}

.editor-panel {
  position: relative;
  width: min(960px, 92vw);
  max-height: 82vh;
  background: var(--panel);
  border: 1px solid var(--stroke);
  border-radius: 18px;
  padding: 20px;
  box-shadow: var(--shadow);
  overflow: auto;
}

.editor-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 14px;
}

.editor-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.editor-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 16px;
}

.editor-section {
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 14px;
  padding: 14px;
  background: rgba(12, 18, 26, 0.6);
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 0.9rem;
}

.field input,
.field select,
.field textarea {
  width: 100%;
  background: rgba(8, 12, 16, 0.9);
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 10px;
  color: var(--text);
  padding: 10px;
  font-size: 0.9rem;
}

.layout-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.editor-note {
  color: var(--muted);
  font-size: 0.85rem;
}

/* Live Preview Styles */
.live-preview-view {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #0a0a0a;
}

.preview-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: #000;
  position: relative;
  overflow: hidden;
}

.video-container {
  flex: 1;
  position: relative;
  background: #000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-video {
  max-width: 100%;
  max-height: 100%;
  display: block;
}

.preview-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 10;
}

.preview-controls {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px;
  background: rgba(20, 20, 20, 0.95);
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.preview-controls .button {
  padding: 8px 16px;
  background: rgba(47, 230, 168, 0.2);
  color: var(--accent);
  border: 1px solid rgba(47, 230, 168, 0.5);
  border-radius: 4px;
  cursor: pointer;
  font-size: 13px;
  transition: all 0.2s;
}

.preview-controls .button:hover {
  background: rgba(47, 230, 168, 0.3);
  border-color: rgba(47, 230, 168, 0.7);
}

.preview-info {
  flex: 1;
  text-align: right;
  color: rgba(255, 255, 255, 0.6);
  font-size: 12px;
}


