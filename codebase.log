            })
            : null,
        props.placementBox.active
            ? element("div", {
                className: "canvas-placement-box",
                style: `left: ${props.placementBox.x}px; top: ${props.placementBox.y}px; width: ${props.placementBox.width}px; height: ${props.placementBox.height}px;`
            })
            : null
    );
};



