  "components": {
    "schemas": {
      "ToonHandle": {
        "pattern": "^([1235])-S2-(\\d+)-(\\d+)$",
        "type": "string",
        "properties": {
          "region": {
            "type": "string",
            "enum": [
              "US",
              "EU",
              "KR",
              "CN"
            ]
          },
          "battlenetId": {
            "type": "integer",
            "format": "int64"
          },
          "realm": {
            "type": "integer",
            "format": "int32"
          }
        },
        "description": "regionId-S2-characterRealm-characterBattlenetId",
        "example": "2-S2-1-3141896"
      },
      "Account": {
        "required": [
          "partition"
        ],
        "type": "object",
        "properties": {
          "battleTag": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "partition": {
            "type": "string",
            "enum": [
              "GLOBAL",
              "CHINA"
            ]
          },
          "hidden": {
            "type": "boolean"
          }
        }
      },
      "BaseLeague": {
        "required": [
          "queueType",
          "teamType",
          "type"
        ],
        "type": "object",
        "properties": {
          "type": {
