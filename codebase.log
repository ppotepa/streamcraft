    };

    private static readonly Dictionary<string, (int x, int y, int blur, string color)[]> CategoryShadows = new()
    {
        ["modern"] = [(0, 0, 0, "rgba(0,0,0,0)"), (0, 1, 2, "rgba(15,23,42,0.18)")],
        ["retro"] = [(1, 1, 0, "rgba(0,0,0,0.35)"), (2, 2, 2, "rgba(0,0,0,0.35)")],
