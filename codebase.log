        new("designer", "Designer", new[] { "Montserrat", "Bebas Neue", "Arial Black" }),
        new("overlay", "Stream / Overlay", new[] { "Oswald", "Roboto Condensed", "Arial" }),
        new("mono", "Mono / Code", new[] { "JetBrains Mono", "Roboto Mono", "Courier New" })
